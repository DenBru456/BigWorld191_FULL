<root>
	<Properties>
		<accountName>
			<Type>			STRING			</Type>
			<Flags>			BASE_AND_CLIENT	</Flags>
			<Persistent>	true			</Persistent>
			<DatabaseLength> 100			</DatabaseLength>
			<Identifier>	true			</Identifier>
		</accountName>

		<persistentCharacterList>
			<Type>			ARRAY <of> PERSISTENT_CHARACTER_INFO </of>	</Type>
			<Flags>			BASE				</Flags>
			<Persistent>	true		</Persistent>
		</persistentCharacterList>

		<characterList>
			<Type>			ARRAY <of> CHARACTER_INFO </of>		</Type>
			<Flags>			BASE_AND_CLIENT		</Flags>
		</characterList>

		<!-- --- Logon/Billing stuff --- -->
		<password>
			<Type>			STRING		</Type>
			<Flags>			BASE		</Flags>
			<Default>					</Default>
			<Persistent>	true			</Persistent>
		</password>
		
		<activeCharacter>
			<Type>			MAILBOX		</Type>
			<Flags>			BASE		</Flags>
		</activeCharacter>
		
		<lastClientIpAddr>
			<Type>			UINT32		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0			</Default>
		</lastClientIpAddr>
		
	</Properties>

	<ClientMethods>
		<logMessage>
			<Arg>	STRING </Arg> <!-- messages to be displayed on client -->
		</logMessage>

		<failLogon>
			<Arg>	STRING	</Arg>	<!-- message to show on console -->
		</failLogon>		

		<createCharacterCallback>
			<Arg>	BOOL	</Arg>
			<Arg>	STRING	</Arg> <!-- message to show on console -->
			<Arg>	ARRAY <of> CHARACTER_INFO </of>	</Arg>
		</createCharacterCallback>
	</ClientMethods>

	<BaseMethods>
		<switchCharacter>
			<Exposed/>
			<Arg>	STRING	</Arg>	<!-- character name -->
			<Arg>	STRING	</Arg>	<!-- character type -->
		</switchCharacter>

		<createNewAvatar>
			<Exposed/>
			<Arg>	STRING	</Arg>	<!-- character name -->
		</createNewAvatar>

		<characterBeginPlay>
			<Exposed/>
			<Arg>	STRING	</Arg>	<!-- character name -->
		</characterBeginPlay>	

		<!-- Called by an Avatar on death -->
		<onAvatarDeath>
			<Arg>	DBID	</Arg>	<!-- Avatar database ID -->
			<!-- The characters model at the time of death/logoff. -->
			<Arg>	PACKED_AVATAR_MODEL		</Arg>
		</onAvatarDeath>

		<webGetCharacterList>
			<ReturnValues>
				<characters>	ARRAY	<of>PYTHON</of>	
				</characters>
			</ReturnValues>
		</webGetCharacterList>

		<webChooseCharacter>
			<Arg>		STRING		</Arg>	<!-- character name -->
			<Arg>		STRING		</Arg>	<!-- character type -->
			<ReturnValues>
				<errMsg>		STRING		</errMsg>
				<character>		MAILBOX		</character>
			</ReturnValues>
		</webChooseCharacter>

		<webCreateCharacter>
			<Arg>		STRING		</Arg>	<!-- character name -->
			<ReturnValues>
				<success>		BOOL		</success>
				<errMsg>		STRING		</errMsg>
			</ReturnValues>
		</webCreateCharacter>

	</BaseMethods>

	<CellMethods>
	</CellMethods>

</root>
