<rain.xml>
	<Actor> particles
		<ParticleSystem>	particles/rain_fog.xml	</ParticleSystem>
	</Actor>

	<Actor> cameraParticles
		<ParticleSystem>	particles/camera_rain.xml	</ParticleSystem>
	</Actor>
	
	<Joint>	particles
		<DummyModel/>
	</Joint>

	<Joint>	cameraParticles
		<DummyModel/>
	</Joint>

	<Event> particles
		<ForceParticle/>
	</Event>	
	
	<Event> particles
		<RampTimeTriggeredParticles>
			<fadeTime>	2.0	</fadeTime>
		</RampTimeTriggeredParticles>
	</Event>

	<Event> cameraParticles
		<RampTimeTriggeredParticles>
			<fadeTime>	1.0	</fadeTime>
		</RampTimeTriggeredParticles>
	</Event>

</rain.xml>
