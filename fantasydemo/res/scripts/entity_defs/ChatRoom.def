<root>
	<!-- BaseApp only -->
	<Properties>
		<name>
			<Type> STRING </Type>
		</name>
	
		<members>
			<Type> ARRAY <of>OBJECT_ID</of> </Type>
			<Flags> PRIVATE </Flags>
		</members>
	</Properties>

	<ClientMethods>
	</ClientMethods>

	<CellMethods>
	</CellMethods>

	<BaseMethods>
		<broadcast>
			<Arg> STRING </Arg> <!-- what's been said -->
		</broadcast>
		
		<enter>
			<Arg> OBJECT_ID </Arg> <!-- who's entering -->
		</enter>

		<leave>
			<Arg> OBJECT_ID </Arg> <!-- who's leaving -->
		</leave>
	</BaseMethods>
</root>
